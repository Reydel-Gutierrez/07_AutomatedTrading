# Copy to /etc/agentic-portfolio/env on the Pi. Do not commit the live file.
# Permissions:
#   sudo chown root:agentic /etc/agentic-portfolio/env
#   sudo chmod 640 /etc/agentic-portfolio/env
#
# Put the real OpenAI key on the Pi only. Never print it, never put it in
# Git, source, the systemd unit, logs, or state.

OPENAI_API_KEY=
AGENTIC_RUNTIME_MODE=LIVE
DASHBOARD_ENVIRONMENT=LIVE
