# Copy to /etc/agentic-portfolio/env on the Pi. Do not commit the live file.
# Permissions:
#   sudo chown root:agentic /etc/agentic-portfolio/env
#   sudo chmod 640 /etc/agentic-portfolio/env
#
# Put the real OpenAI key on the Pi only. Never print it, never put it in
# Git, source, the systemd unit, logs, or state.

OPENAI_API_KEY=
AGENTIC_RUNTIME_MODE=LIVE
DASHBOARD_ENVIRONMENT=LIVE

# --- Who authorizes orders -------------------------------------------------
# OBSERVE        research, decide and run the Risk Gate; never creates an order
# HUMAN_APPROVAL every order waits for APPROVE on the dashboard (committed default)
# AUTONOMOUS     the deterministic policy authorizes clean Risk Gate PASS orders
#                inside config/execution_policy.json limits; everything else is
#                escalated to you. Typos fall back to HUMAN_APPROVAL.
AGENTIC_EXECUTION_MODE=HUMAN_APPROVAL

# --- May the executor write to Robinhood (LIVE only) -------------------------
# Ambiguous values fail closed (treated as false).
AGENTIC_LIVE_ORDER_PLACEMENT=false

# --- Emergency stop -----------------------------------------------------------
# Set to 1 to stop ALL order submission regardless of anything else. Only
# editing this file (and restarting) clears it. Day-to-day, use the dashboard
# System page or `python scripts/kill_switch.py engage --reason "..."`.
AGENTIC_KILL_SWITCH=0

AI_MONTHLY_HARD_CAP_USD=10.00

# PAPER only: simulated account starting cash and a separate state root.
# AGENTIC_PAPER_STARTING_CASH=10000
# AGENTIC_STATE_ROOT=/opt/agentic-portfolio/var/paper

# Removed (no longer read): LIVE_ORDER_PLACEMENT, REQUIRE_HUMAN_APPROVAL, AUTO_EXECUTION.
