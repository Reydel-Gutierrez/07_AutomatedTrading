# /etc/agentic-portfolio/env  (root:agentic, 640). Never commit the real file.

# The Execution Desk may write to Robinhood only when this is exactly true.
AGENTIC_LIVE_ORDER_PLACEMENT=false

# 1 forces the kill switch on (release requires editing this file + restart).
AGENTIC_KILL_SWITCH=0

# Phone alerts (optional).
TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AGENTIC_PUBLIC_DASHBOARD_URL=

# Phase 2+ (CIO conversations). Budget is set in HQ → System.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
