{
  "version": "2.0.0",
  "updated_at": "2026-10-03",
  "description": "PAPER and LIVE run the same pipeline. LIVE: the Agentic Robinhood account is the single source of truth (state at the project root). PAPER: a simulated PaperBroker account fed by real read-only market data (state under var/paper or AGENTIC_STATE_ROOT). Broker writes in LIVE need AGENTIC_LIVE_ORDER_PLACEMENT=true; who authorizes orders is config/execution_policy.json.",
  "mode": "PAPER",
  "live_order_placement_enabled": false,
  "ai_monthly_hard_cap_usd": 10.0,
  "fail_closed_if_placement_ambiguous": true,
  "env": {
    "mode": [
      "AGENTIC_RUNTIME_MODE",
      "DASHBOARD_ENVIRONMENT"
    ]
  },
  "live": {
    "source_of_truth": "robinhood_agentic_account",
    "account_config": "config/account_rules.json",
    "fail_closed_if_wrong_account": true,
    "fail_closed_if_data_unavailable": true,
    "never_read_paper_book": true,
    "never_use_paper_fills": true,
    "never_use_paper_thesis_activation": true,
    "snapshot_dir": "state/live_book",
    "mcp_read_tools": [
      "get_accounts",
      "get_portfolio",
      "get_equity_positions",
      "get_equity_quotes",
      "get_equity_orders"
    ],
    "mcp_forbidden": [
      "place_equity_order",
      "cancel_equity_order",
      "review_equity_order"
    ],
    "mcp_note": "mcp_read_tools/mcp_forbidden apply to the read-only observation transport. Order tools are only reachable through the separate executor write adapter."
  },
  "readonly_mcp": {
    "url": "https://agent.robinhood.com/mcp/trading",
    "mode": "READ_ONLY",
    "source": "shared production transport",
    "env": {
      "url": [
        "AGENTIC_READONLY_MCP_URL"
      ],
      "token": [
        "AGENTIC_READONLY_MCP_TOKEN"
      ],
      "token_file": [
        "AGENTIC_READONLY_MCP_TOKEN_FILE"
      ],
      "oauth_home": [
        "AGENTIC_READONLY_MCP_HOME"
      ]
    }
  },
  "paper": {
    "source_of_truth": "paper_broker",
    "state_root_env": "AGENTIC_STATE_ROOT",
    "default_state_root": "var/paper",
    "starting_cash_env": "AGENTIC_PAPER_STARTING_CASH",
    "market_data": "read-only Robinhood quotes (same transport as LIVE observation)"
  },
  "execution_policy": "config/execution_policy.json"
}
