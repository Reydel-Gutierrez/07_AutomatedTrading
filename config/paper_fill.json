{
  "version": "1.0.0",
  "updated_at": "2026-08-30",
  "description": "Paper fill + blotter reconciliation. Simulates fills for PAPER_ONLY OrderPlans. No investment logic. No broker review/place/cancel. No stop orders. No money movement. Isolated from the live Agentic book.",
  "paper_only": true,
  "paper_environment": true,
  "live_trade_actions_allowed": false,
  "auto_execution": false,
  "require_human_approval": true,
  "does_not_create_stop_orders": true,
  "does_not_call_execution_tools": true,
  "does_not_move_money": true,
  "does_not_modify_live_thesis_or_account_state": true,
  "fillable_actions": ["BUY", "ADD", "REDUCE", "SELL"],
  "non_fillable_actions": ["HOLD", "WATCH", "REJECT", "NO_ACTION"],
  "allowed_fill_status": ["FILLED", "REJECTED"],
  "fill_model": "market_at_eligible_quote_or_plan_reference_price",
  "applies_estimated_slippage_to_fill_price": false,
  "records_estimated_slippage": true,
  "partial_fills": false,
  "lot_method": "fifo_average_cost",
  "quote_max_age_seconds": 300,
  "quantity_notional_abs_tolerance": 0.01,
  "quantity_notional_rel_tolerance": 1e-6,
  "position_pct_tolerance": 0.001,
  "quantity_zero_epsilon": 1e-9,
  "nav_abs_tolerance": 0.01,
  "forbidden_tools": [
    "review_equity_order",
    "place_equity_order",
    "cancel_equity_order",
    "create_scan",
    "watchlist_writes",
    "any_deposit_withdrawal_transfer"
  ]
}
