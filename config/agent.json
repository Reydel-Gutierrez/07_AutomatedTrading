{
  "version": "2.0.0",
  "updated_at": "2026-10-03",
  "description": "24/7 autonomous portfolio-management service. The process stays alive; the scheduler is an internal orchestrator. Who may authorize orders is config/execution_policy.json; broker writes need AGENTIC_LIVE_ORDER_PLACEMENT (LIVE) or the PaperBroker (PAPER).",
  "invariants": {
    "ai_has_broker_access": false,
    "ai_may_authorize_orders": false,
    "orders_only_via_executor": true,
    "risk_gate_rerun_at_send_time": true,
    "authorization_policy": "config/execution_policy.json",
    "kill_switch_release_requires_human": true,
    "continue_when_ai_exhausted": true,
    "continue_on_job_failure": true
  },
  "heartbeat_seconds": 30,
  "max_sleep_seconds": 30,
  "min_sleep_seconds": 0.05,
  "job_timeout_seconds": 900,
  "pid_path": "state/runtime/agent.pid",
  "health_path": "state/runtime/health.json",
  "state_path": "state/runtime/orchestrator.json",
  "lock_dir": "state/runtime/locks",
  "activity_log": "logs/agent_activity.jsonl",
  "watch": {
    "price_move_pct": 0.03,
    "entry_approach_pct": 0.015,
    "ai_cooldown_minutes": 180,
    "thesis_ttl_hours": 168,
    "stale_after_hours": 336,
    "intrasession_retry_minutes": 15
  },
  "conditions": {
    "max_spread_bps": 50.0,
    "min_dollar_volume": 1000000.0,
    "require_regular_hours_quotes": true,
    "never_use_offhours_liquidity": true
  },
  "approval": {
    "ttl_hours": 24,
    "approve_status": "APPROVED",
    "execution_disabled_status": "APPROVED_EXECUTION_DISABLED"
  },
  "ai": {
    "skip_when_exhausted": true,
    "continue_without_ai": true,
    "candidate_cooldown_minutes": 180,
    "material_price_move_pct": 0.03
  },
  "connection": {
    "reconnect_every_minutes": 5,
    "healthy_check_every_minutes": 15,
    "fail_closed_on_auth_loss": true
  }
}
