{
  "version": "1.0.0",
  "updated_at": "2026-08-30",
  "description": "Investment Thesis + Portfolio Decision. AI interprets research and proposes action/allocation. Python validates, persists DRAFT theses, converts to ProposedAction, and sends to the existing Risk Gate. No stock-picking thresholds. No broker stops.",
  "does_not_create_active_theses": true,
  "does_not_create_broker_stop_orders": true,
  "does_not_call_execution_tools": true,
  "thesis_remains_draft_until_real_execution": true,
  "no_action_always_valid": true,
  "cash_is_valid_alternative": true,
  "spy_is_valid_alternative": true,
  "unused_sleeve_capacity_is_not_a_mandate": true,
  "no_universal_valuation_thresholds": true,
  "no_universal_growth_thresholds": true,
  "no_universal_rsi_thresholds": true,
  "alternatives": ["CASH", "SPY"],
  "valid_decisions": [
    "BUY",
    "ADD",
    "HOLD",
    "REDUCE",
    "SELL",
    "WATCH",
    "REJECT",
    "NO_ACTION"
  ],
  "decision_aliases": {
    "EXIT": "SELL"
  },
  "buy_add_requires_research_conclusion": "ADVANCE_TO_THESIS",
  "buy_add_requires_research_status": "RESEARCH_COMPLETE",
  "exit_policy": {
    "CORE_GROWTH": {
      "thesis_based": true,
      "mandatory_fixed_stop_loss": false,
      "price_invalidation": "optional",
      "event_invalidation": "optional",
      "technical_invalidation": "optional",
      "risk_invalidation": "optional"
    },
    "OPPORTUNISTIC": {
      "thesis_based": true,
      "mandatory_fixed_stop_loss": false,
      "price_invalidation": "optional",
      "event_invalidation": "optional",
      "technical_invalidation": "optional",
      "risk_invalidation": "optional"
    },
    "TACTICAL": {
      "thesis_based": true,
      "mandatory_fixed_stop_loss": false,
      "price_or_technical_invalidation": "required_for_buy_add",
      "event_invalidation": "optional",
      "risk_invalidation": "optional"
    },
    "SPECULATIVE": {
      "thesis_based": true,
      "mandatory_fixed_stop_loss": false,
      "risk_invalidation": "required_for_buy_add",
      "price_invalidation": "optional",
      "event_invalidation": "optional",
      "technical_invalidation": "optional"
    }
  }
}
