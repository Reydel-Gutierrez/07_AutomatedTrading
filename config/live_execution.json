{
  "version": "2.0.0",
  "updated_at": "2026-10-03",
  "description": "OrderExecutor send-time settings (LIVE and PAPER). Authorization (human or autonomous) is config/execution_policy.json. Every send re-runs the Risk Gate on fresh facts.",
  "live_order_placement_enabled": false,
  "default_order_type": "market",
  "default_time_in_force": "gfd",
  "market_hours": "regular_hours",
  "prefer_dollar_amount_for_buy": true,
  "min_order_notional_usd": 1.0,
  "quantity_decimal_places": 6,
  "revalidation": {
    "max_quote_move_pct": 0.03,
    "max_nav_change_pct": 0.1,
    "max_buying_power_change_pct": 0.15,
    "max_cash_change_pct": 0.15,
    "max_allocation_delta_pct_points": 1.0,
    "require_regular_hours": true,
    "require_tradable": true,
    "reject_duplicate_open_order": true,
    "reject_if_approval_expired": true,
    "reject_if_thesis_invalidated": true
  },
  "idempotency": {
    "intent_id_prefix": "exec",
    "lock_stale_seconds": 120,
    "ambiguous_does_not_retry": true
  }
}
